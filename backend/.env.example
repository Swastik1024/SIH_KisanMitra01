# -------------------------------------------------
#  KisanMitra Backend -- Environment Template (.env.example)
#  Copy this file to .env and fill in your values
# -------------------------------------------------

ENVIRONMENT=development
SECRET_KEY=your_256_bit_secret_key_here
DATABASE_URL=sqlite:///./agrimart.db

# Admin Initial Setup (Set these in Render / .env to create your secure admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePasswordHere

# Razorpay Payments -- https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Email SMTP (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# SMS API (Twilio or similar)
SMS_API_KEY=your_sms_key

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
